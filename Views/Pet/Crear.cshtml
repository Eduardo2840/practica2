@model practica2.Models.Pet
@{
    ViewData["Title"] = "Registrar Mascota";
}

<h1 class="text-center mb-4 text-primary">Registrar Mascota</h1>


<div class="container mt-5">
    <div class="card shadow-lg p-4 rounded">
        <form asp-action="Crear" method="post">
            <div class="mb-4">
                <label asp-for="Nombre" class="form-label h5">Nombre(*)</label>
                <input asp-for="Nombre" class="form-control p-3" required aria-required="true" placeholder="Ingrese el nombre de la mascota"/>
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Edad" class="form-label h5">Edad(*)</label>
                <input asp-for="Edad" type="number" min="0" class="form-control p-3" required aria-required="true" placeholder="Edad de la mascota"/>
                <span asp-validation-for="Edad" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Tipo" class="form-label h5">Tipo (perro, gato, etc.) (*)</label>
                <input asp-for="Tipo" class="form-control p-3" required aria-required="true" placeholder="Tipo de mascota"/>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>

            <div class="mb-5">
                <label asp-for="EstadoAdopcion" class="form-label h5">Estado de Adopción (*)</label>
                <select asp-for="EstadoAdopcion" class="form-select p-3" required>
                    <option value="disponible">Disponible</option>
                    <option value="adoptada">Adoptado(a)</option>
                </select>
                <span asp-validation-for="EstadoAdopcion" class="text-danger"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-success btn-lg w-100">Registrar mi Mascota</button>
            </div>
        </form>
    </div>
</div>

<!-- Estilos adicionales para mejorar la experiencia visual -->
<style>
    .container {
        max-width: 600px;
    }
    .card {
        background-color: #f8f9fa;
    }
    .form-label {
        font-weight: bold;
        color: #333;
    }
    .form-control, .form-select {
        border-radius: 10px;
        font-size: 1rem;
    }
    .btn {
        padding: 15px;
        font-size: 1.2rem;
    }
    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }
    .btn-success:hover {
        background-color: #218838;
        border-color: #1e7e34;
    }
</style>
