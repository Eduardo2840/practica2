@{
    ViewData["Title"] = "Asignar Mascota";
    var mascotas = ViewBag.Mascotas as List<practica2.Models.Pet>;
}

<div class="container mt-5">
    <div class="card shadow-lg p-4 rounded">
        <h3 class="mb-4 text-center text-primary">Asignar Mascota a Adoptante</h3>

        <form asp-action="Adoptar" method="post">
            <!-- Dropdown para Mascota -->
            <div class="mb-4">
                <label for="PetId" class="form-label h5">Selecciona una Mascota</label>
                <select id="PetId" name="PetId" class="form-select p-3" required>
                    <option value="">-- Selecciona una mascota --</option>
                    @foreach (var pet in mascotas)
                    {
                        <option value="@pet.Id">@pet.Nombre (@pet.Tipo)</option>
                    }
                </select>
            </div>

            <!-- Campo de Nombre del Adoptante -->
            <div class="mb-4">
                <label for="NombreAdoptante" class="form-label h5">Nombre del Adoptante</label>
                <input type="text" name="NombreAdoptante" id="NombreAdoptante" class="form-control p-3" required placeholder="Nombre completo del adoptante"/>
            </div>

            <!-- Botón de Submit -->
            <div class="text-center">
                <button type="submit" class="btn btn-primary btn-lg w-100">Asignar Adopción</button>
            </div>
        </form>
    </div>
</div>

<!-- Estilos adicionales para mejorar la experiencia visual -->
<style>
    .container {
        max-width: 600px;
    }
    .card {
        background-color: #f8f9fa;
    }
    .form-label {
        font-weight: bold;
        color: #333;
    }
    .form-control, .form-select {
        border-radius: 10px;
        font-size: 1.1rem;
    }
    .form-select {
        padding: 12px;
    }
    .btn {
        padding: 15px;
        font-size: 1.2rem;
    }
    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }
    .btn-primary:hover {
        background-color: #0056b3;
        border-color: #004085;
    }
</style>
