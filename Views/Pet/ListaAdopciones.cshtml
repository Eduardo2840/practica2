@model List<practica2.Models.Adoption>

@{
    ViewData["Title"] = "Lista de Adopciones";
}

<div class="container mt-5">
    <div class="card shadow-lg p-4 rounded">
        <h3 class="mb-4 text-center text-primary">Lista de Adopciones</h3>

        <table class="table table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Nombre de la Mascota</th>
                    <th>Nombre del Adoptante</th>
                    <th>Estado de Adopción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var adopcion in Model)
                {
                    <tr>
                        <td>@adopcion.Pets.Nombre</td>
                        <td>@adopcion.Adopter.Nombre</td>
                        <td>
                            @if (@adopcion.Pets.EstadoAdopcion == "disponible")
                            {
                                <span class="badge bg-warning text-dark">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Adoptado</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

